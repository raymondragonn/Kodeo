# Cal.com — slug del evento a embeber (username/event-slug)
VITE_CAL_LINK=kodeo/consulta

# URL del backend PHP.
# Desarrollo:  http://localhost:8000  (este archivo se copia a .env y NO se commitea)
# Producción:  https://api.kodeo.mx  (ver .env.production, ese sí se commitea)
VITE_BACKEND_URL=http://localhost:8000

# Google OAuth Client ID (para OAuth2 directo — opcional si usas Firebase)
VITE_GOOGLE_CLIENT_ID=

# Apple OAuth Client ID (para Apple Sign In — opcional si usas Firebase)
VITE_APPLE_CLIENT_ID=

# Firebase Configuration
# Obtén estos valores en: Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
